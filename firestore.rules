rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Users collection - users can read/write their own data; admins for verification tools
    match /users/{userId} {
      allow read: if isOwner(userId) || isAuthenticated();
      allow create: if (isOwner(userId) &&
        request.resource.data.get('PackageSubscribed', 'Free') == 'Free') ||
        isAdmin();
      allow update: if (isOwner(userId) &&
        request.resource.data.get('PackageSubscribed', 'Free') ==
          resource.data.get('PackageSubscribed', 'Free')) ||
        isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Packages collection - readable by authenticated users, writable by admins
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Proposals collection - users manage own; admins sync verification / support
    match /proposals/{country}/{gender}/{userId} {
      allow read: if isOwner(userId) || isAuthenticated();
      allow create: if (isOwner(userId) &&
        request.resource.data.get('PackageSubscribed', 'Free') == 'Free') ||
        isAdmin();
      allow update: if (isOwner(userId) &&
        request.resource.data.get('PackageSubscribed', 'Free') ==
          resource.data.get('PackageSubscribed', 'Free')) ||
        isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Payments collection - users can read their own payments, admins can manage all
    match /payments/{paymentId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin() || (isAuthenticated() &&
        request.auth.uid == resource.data.userId);
    }

    // The app stores conversations in Chats/{chatId}/chats/{messageId}.
    match /Chats/{chatId} {
      function isChatParticipant() {
        return isAuthenticated() &&
          resource.data.users is list &&
          request.auth.uid in resource.data.users;
      }

      allow read: if isChatParticipant();
      allow create: if isAuthenticated() &&
        request.resource.data.users is list &&
        request.auth.uid in request.resource.data.users;
      allow update: if isChatParticipant() &&
        request.resource.data.users == resource.data.users;

      match /chats/{messageId} {
        function isConversationParticipant() {
          let chat = get(
            /databases/$(database)/documents/Chats/$(chatId)
          );
          return isAuthenticated() &&
            chat.data.users is list &&
            request.auth.uid in chat.data.users;
        }

        allow read: if isConversationParticipant();
        allow create: if isConversationParticipant() &&
          request.resource.data.sentBy == request.auth.uid;
      }
    }

    // Chat messages - users can read/write their own conversations
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);
    }

    // Notifications - users can read their own notifications
    match /notifications/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Admin-only collections
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Public configuration (readable by all authenticated users)
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // FCM tokens - users can manage their own tokens
    match /fcmTokens/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User-submitted safety reports are private and cannot be changed by clients.
    match /reports/{reportId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'reporterUserId',
          'reportedUserId',
          'reason',
          'details',
          'createdAt',
          'status'
        ]) &&
        request.resource.data.reporterUserId == request.auth.uid &&
        request.resource.data.reportedUserId is string &&
        request.resource.data.reportedUserId != request.auth.uid &&
        request.resource.data.reason in [
          'Inappropriate profile',
          'Fake or misleading information',
          'Harassment or abusive behavior',
          'Other'
        ] &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 1000 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // Default deny rule for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
