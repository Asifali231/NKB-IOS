rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Users collection - users can read/write their own data; admins for verification tools
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAuthenticated(); // Allow reading other users for matchmaking
      allow write: if isAdmin();
    }

    // Packages collection - readable by authenticated users, writable by admins
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Proposals collection - users manage own; admins sync verification / support
    match /proposals/{country}/{gender}/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAuthenticated(); // Allow reading for matchmaking
      allow write: if isAdmin();
    }

    // Payments collection - users can read their own payments, admins can manage all
    match /payments/{paymentId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin() || (isAuthenticated() &&
        request.auth.uid == resource.data.userId);
    }

    // Chat messages - users can read/write their own conversations
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);
    }

    // Notifications - users can read their own notifications
    match /notifications/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Admin-only collections
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Public configuration (readable by all authenticated users)
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // FCM tokens - users can manage their own tokens
    match /fcmTokens/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Default deny rule for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
